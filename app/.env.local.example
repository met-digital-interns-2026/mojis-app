# Copy this file to .env.local and fill in your Supabase credentials.
#
# To get these values:
#   1. Go to supabase.com and sign in
#   2. Create a new project (or open your existing one)
#   3. Go to Settings > API (in the left sidebar)
#   4. Copy "Project URL" → paste as NEXT_PUBLIC_SUPABASE_URL
#   5. Copy "anon public" key → paste as NEXT_PUBLIC_SUPABASE_ANON_KEY
#

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Image similarity search — used by the /scan page to identify artworks.
# Get this from Vercel Dashboard > Project Settings > Deployment Protection > Protection Bypass for Automation.
# If not set, the scan page will still work but may fail on the preview deployment.
NEXT_PUBLIC_IMAGE_SEARCH_BYPASS_SECRET=your-bypass-secret-here
