# Copy this file to .env.local and fill in your Supabase credentials.
#
# To get these values:
#   1. Go to supabase.com and sign in
#   2. Create a new project (or open your existing one)
#   3. Go to Settings > API (in the left sidebar)
#   4. Copy "Project URL" → paste as NEXT_PUBLIC_SUPABASE_URL
#   5. Copy "anon public" key → paste as NEXT_PUBLIC_SUPABASE_ANON_KEY
#

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Default UI locale. Visitors can switch languages in the app.
# Supported values: en, es.
NEXT_PUBLIC_LOCALE=en

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Guest sessions are signed into an HttpOnly cookie so the browser can no longer
# forge the underlying guest_id used for reactions, comments, and likes.
GUEST_SESSION_SECRET=replace-with-a-long-random-string

# Image similarity search — used by the /scan page to identify artworks.
# Get this from Vercel Dashboard > Project Settings > Deployment Protection > Protection Bypass for Automation.
# No NEXT_PUBLIC_ prefix — this stays server-side only (proxied via /api/scan).
IMAGE_SEARCH_BYPASS_SECRET=your-bypass-secret-here
